# This file documents optional settings. The server does not load .env files.
# Set variables in your local shell; never commit real tokens.
LIARA_PORT=4310
LIARA_DEMO_PORT=4322

# Required only for the connected runtime; unused by the recording demo.
LIARA_CODEX_BIN=codex
LIARA_API_TOKEN=
LIARA_GITHUB_TOKEN=
LIARA_SOURCE_ROOTS=[]

# Cloud mutation is disabled by default. Example target IDs in the source are
# synthetic and must be deliberately configured/reviewed for a real deployment.
LIARA_ENABLE_DEPLOYMENT=0
