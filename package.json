{
  "name": "liara-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "npm run demo:guide && tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "demo": "node scripts/serve-demo.mjs",
    "demo:open": "node scripts/serve-demo.mjs --open",
    "demo:guide": "node --import tsx scripts/prepare-demo.ts",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify:codex": "tsx scripts/verify-codex.ts",
    "verify:repair": "tsx scripts/verify-repair.ts",
    "verify:liara": "tsx scripts/verify-liara.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tar": "7.5.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
